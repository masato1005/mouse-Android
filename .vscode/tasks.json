{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Android: Build Debug",
      "type": "shell",
      "command": "${workspaceFolder}\\gradlew.bat",
      "args": [
        ":app:assembleDebug"
      ],
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": {
        "owner": "kotlin",
        "fileLocation": "absolute",
        "pattern": {
          "regexp": "^e: file:///(.+):(\\d+):(\\d+) (.+)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "message": 4
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      }
    }
  ]
}
